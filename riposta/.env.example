# Skopiuj do .env i uzupełnij. Plik .env nie trafia do gita.

PORT=3000
PUBLIC_URL=http://localhost:3000        # na produkcji: https://twojadomena.pl (potrzebne do powrotu z bramki i webhooków)
NODE_ENV=development

# --- AI ---------------------------------------------------------------------
# Bez klucza aplikacja działa w trybie testowym (RIPOSTA_AI=mock, przewidywalne odpowiedzi).
ANTHROPIC_API_KEY=
# RIPOSTA_AI=claude                     # claude | mock
# RIPOSTA_MODEL=claude-opus-5-5         # domyślnie najlepszy model; tańsza opcja: claude-haiku-5-5
# RIPOSTA_EFFORT=low                    # low | medium | high

# --- Płatności ----------------------------------------------------------------
PAYMENT_PROVIDER=mock                   # mock | przelewy24 | stripe

# Przelewy24 (panel.przelewy24.pl -> Moje dane / Dane API)
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
P24_SANDBOX=true

# Stripe (dashboard.stripe.com -> Developers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Inne -------------------------------------------------------------------------
# DATA_FILE=./data/db.json
# RATE_LIMIT_PER_MINUTE=20
# TRUST_PROXY=true                      # za reverse proxy (nginx/Caddy/Docker): IP klienta z X-Forwarded-For

# --- Panel właściciela -----------------------------------------------------------
# Token do GET /api/admin/stats (nagłówek Authorization: Bearer <token>) i strony /admin.html.
# Puste = panel wyłączony (404). Wygeneruj np.: openssl rand -hex 24
ADMIN_TOKEN=
